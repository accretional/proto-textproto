  children: {
    g: {
      attrs: {
        svg_graphics_element: {
          svg_element: {
            class_name: { base_val: "func_g" }
            global_event_handlers: {
              onclick: "zoom(this)"
              onmouseover: "s(this)"
              onmouseout: "c()"
            }
          }
        }
      }
      children: { title: { text_content: "main (100%)" } }
      children: { rect: { attrs: {
        x:      { base_val: { value_as_string: "0"    } }
        y:      { base_val: { value_as_string: "232"  } }
        width:  { base_val: { value_as_string: "1200" } }
        height: { base_val: { value_as_string: "50"   } }
        svg_geometry_element: { svg_graphics_element: { svg_element: {
          style: "fill:#c0392b;stroke:#1a1a2e;stroke-width:0.5"
        } } }
      } } }
      children: { text_elem: { attrs: { svg_text_positioning: {
        x: { base_val: { items: { value_as_string: "600" } } }
        y: { base_val: { items: { value_as_string: "262" } } }
        svg_text_content: { svg_graphics_element: { svg_element: {
          style: "font-size:13px;text-anchor:middle;fill:#fff;pointer-events:none"
        } } }
      } } runs: { text: "main (100%)" } } }
    }
  }

