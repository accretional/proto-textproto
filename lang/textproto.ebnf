(* TextProto Grammar — Protocol Buffers Text Format Specification *)
(* Adapted for gluon v2 EBNF *)
(*                                                                  *)
(* Convention:                                                       *)
(*   Uppercase = syntactic — whitespace auto-skipped between tokens  *)
(*   Lowercase = lexical   — no whitespace auto-skip (token innards) *)
(*                                                                   *)
(* Comments (#) are stripped by a preprocessor before parsing.       *)

(* ================================================================ *)
(* Top-Level                                                         *)
(* ================================================================ *)

Message = { Field } ;

Field = ScalarField | MessageField ;

ScalarField = field_name , ":" , ScalarFieldValue , [ FieldTerm ] ;

MessageField = field_name , [ ":" ] , MessageFieldValue , [ FieldTerm ] ;

ScalarFieldValue = ScalarList | ScalarValue ;

MessageFieldValue = MessageList | MessageValue ;

FieldTerm = ";" | "," ;

(* ================================================================ *)
(* Lists                                                             *)
(* ================================================================ *)

ScalarList = "[" , [ ScalarValue , { "," , ScalarValue } ] , "]" ;

MessageList = "[" , [ MessageValue , { "," , MessageValue } ] , "]" ;

(* ================================================================ *)
(* Message Values                                                    *)
(* ================================================================ *)

MessageValue = BraceMessage | AngleMessage ;

BraceMessage = "{" , Message , "}" ;

AngleMessage = "<" , Message , ">" ;

(* ================================================================ *)
(* Scalar Values                                                     *)
(* Syntactic level — WS skipped between sign and literal             *)
(* ================================================================ *)

ScalarValue = StringVal | FloatVal | SignedIdentifier | Identifier
            | HexSignedInteger | OctSignedInteger | DecSignedInteger
            | HexUnsignedInteger | OctUnsignedInteger | DecUnsignedInteger ;

StringVal = string_literal , { string_literal } ;

FloatVal = [ "-" ] , float_literal ;

SignedIdentifier = "-" , ident ;

Identifier = ident ;

HexSignedInteger = "-" , hex_lit ;

OctSignedInteger = "-" , oct_lit ;

DecSignedInteger = "-" , dec_lit ;

HexUnsignedInteger = hex_lit ;

OctUnsignedInteger = oct_lit ;

DecUnsignedInteger = dec_lit ;

(* ================================================================ *)
(* Field Names (lexical)                                             *)
(* ================================================================ *)

field_name = any_name | extension_name | ident ;

extension_name = "[" , type_name , "]" ;

any_name = "[" , url_prefix , "/" , type_name , "]" ;

type_name = ident , { "." , ident } ;

url_prefix = url_char , { url_char } ;

(* ================================================================ *)
(* Identifiers (lexical)                                             *)
(* ================================================================ *)

ident = letter , { letter | dec_digit } ;

(* ================================================================ *)
(* Strings (lexical)                                                 *)
(* ================================================================ *)

string_literal = double_string | single_string ;

double_string = dquote , { dq_char } , dquote ;

single_string = squote , { sq_char } , squote ;

dquote = '"' ;

squote = "'" ;

dq_char = dq_unescaped | escape_sequence ;

sq_char = sq_unescaped | escape_sequence ;

(* Double-quoted unescaped: all non-NUL chars except DQUOTE LF BACKSLASH *)
dq_unescaped = dq_tab | dq_space_bang | dq_hash_bracket | dq_bracket_high ;

dq_tab = "	" ;

dq_space_bang = " " ... "!" ;

dq_hash_bracket = "#" ... "[" ;

dq_bracket_high = "]" ... "􏿿" ;

(* Single-quoted unescaped: all non-NUL chars except SQUOTE LF BACKSLASH *)
sq_unescaped = sq_tab | sq_space_amp | sq_paren_bracket | sq_bracket_high ;

sq_tab = "	" ;

sq_space_amp = " " ... "&" ;

sq_paren_bracket = "(" ... "[" ;

sq_bracket_high = "]" ... "􏿿" ;

(* ================================================================ *)
(* Escape Sequences (lexical)                                        *)
(* ================================================================ *)

escape_sequence = '\' , escaped_char ;

escaped_char = escaped_a | escaped_b | escaped_f | escaped_n | escaped_r
             | escaped_t | escaped_v | escaped_question | escaped_backslash
             | escaped_squote | escaped_dquote
             | octal_escape | hex_escape | unicode_escape_short | unicode_escape_long ;

escaped_a = "a" ... "a" ;

escaped_b = "b" ... "b" ;

escaped_f = "f" ... "f" ;

escaped_n = "n" ... "n" ;

escaped_r = "r" ... "r" ;

escaped_t = "t" ... "t" ;

escaped_v = "v" ... "v" ;

escaped_question = "?" ;

escaped_backslash = '\' ;

escaped_squote = "'" ;

escaped_dquote = '"' ;

octal_escape = oct_digit , [ oct_digit , [ oct_digit ] ] ;

hex_escape = "x" ... "x" , hex_digit , [ hex_digit ] ;

unicode_escape_short = "u" ... "u" , hex_digit , hex_digit , hex_digit , hex_digit ;

unicode_escape_long = "U" ... "U" , hex_digit , hex_digit , hex_digit , hex_digit , hex_digit , hex_digit , hex_digit , hex_digit ;

(* ================================================================ *)
(* Numeric Literals (lexical)                                        *)
(* ================================================================ *)

float_literal = float_with_suffix | int_with_suffix ;

float_with_suffix = float_body , [ float_suffix ] ;

int_with_suffix = dec_lit , float_suffix ;

float_body = dot_float | dec_dot_float | dec_exp_float ;

dot_float = "." , dec_digit , { dec_digit } , [ exponent ] ;

dec_dot_float = dec_lit , "." , { dec_digit } , [ exponent ] ;

dec_exp_float = dec_lit , exponent ;

exponent = ( "E" ... "E" | "e" ... "e" ) , [ "+" | "-" ] , dec_digit , { dec_digit } ;

float_suffix = "F" ... "F" | "f" ... "f" ;

dec_lit = "0" | ( digit1_9 , { dec_digit } ) ;

oct_lit = "0" , oct_digit , { oct_digit } ;

hex_lit = "0" , ( "X" ... "X" | "x" ... "x" ) , hex_digit , { hex_digit } ;

(* ================================================================ *)
(* Character Classes (lexical)                                       *)
(* ================================================================ *)

letter = "A" ... "Z" | "a" ... "z" | "_" ... "_" ;

dec_digit = "0" ... "9" ;

digit1_9 = "1" ... "9" ;

oct_digit = "0" ... "7" ;

hex_digit = "0" ... "9" | "A" ... "F" | "a" ... "f" ;

(* ================================================================ *)
(* URL Characters (lexical — for Any fields)                         *)
(* ================================================================ *)

url_char = url_unreserved | url_sub_delim | url_pct_encoded ;

url_unreserved = letter | dec_digit | "-" | "." | "~" ;

url_sub_delim = "!" | "$" | "&" | "(" | ")" | "*" | "+" | "," | ";" | "=" ;

url_pct_encoded = "%" , hex_digit , hex_digit ;
